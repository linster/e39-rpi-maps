# Large database artifacts live in Git LFS (see output/db/README.md).
#
# Keep these patterns in sync with the e39maps-data recipe: it packages
# output/db/e39maps-osm.sqlite and the routing tiles it names
# (<stem>.routing.tar).
output/db/*.sqlite filter=lfs diff=lfs merge=lfs -text
output/db/*.sqlite3 filter=lfs diff=lfs merge=lfs -text
output/db/*.routing.tar filter=lfs diff=lfs merge=lfs -text
output/db/*.sqlite.zst filter=lfs diff=lfs merge=lfs -text
output/db/*.sqlite3.zst filter=lfs diff=lfs merge=lfs -text
output/db/*.pbf filter=lfs diff=lfs merge=lfs -text
output/db/*.osm.pbf filter=lfs diff=lfs merge=lfs -text
