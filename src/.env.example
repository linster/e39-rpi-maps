# Copy to .env (or set these in the systemd unit) for local/production runs.

# 1 = development (default), 0 = production
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG=0. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Alternatively, read the key from a file (useful on a read-only rootfs).
# DJANGO_SECRET_KEY_FILE=/var/lib/e39maps/secret_key

# Development admin account, created by `migrate` if missing (never
# overwritten). Defaults to admin:e39rpi when DJANGO_DEBUG=1, none otherwise;
# empty = none.
# DJANGO_DEV_ADMIN=admin:e39rpi

# Comma-separated. Example: e39.local,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated, only needed for HTTPS reverse proxies.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to 1 if a reverse proxy terminates TLS.
DJANGO_BEHIND_PROXY=0

# Set to 1 when the site is served over HTTPS (enables HSTS + secure cookies).
DJANGO_HTTPS=0

# Writable state database (users, admin, sessions, user POIs). Survives map
# updates. Defaults to src/db.sqlite3. (DJANGO_DB_PATH: old name, still read.)
# DJANGO_STATE_DB_PATH=/var/lib/e39maps/state.sqlite3

# Read-only map database built by the map toolkit; opened immutable, replaced
# as a whole on a map update. Defaults to output/db/e39maps-osm.sqlite.
# DJANGO_MAP_DB_PATH=/usr/share/e39rpi-maps/data/e39maps-osm.sqlite

# DJANGO_STATIC_ROOT=/var/lib/e39maps/static

# gRPC API for the HMI (manage.py run_grpc_server): listen address and
# server threads.
# DJANGO_GRPC_BIND=0.0.0.0:50051
# DJANGO_GRPC_MAX_WORKERS=4

# Routing tiles (Valhalla), built by the map toolkit next to the map
# database; defaults to e39maps-routing.tar beside DJANGO_MAP_DB_PATH. Cache
# for decoded tiles in MB.
# DJANGO_ROUTING_TILES_PATH=/usr/share/e39rpi-maps/data/e39maps-routing.tar
# DJANGO_ROUTING_CACHE_MB=64

# Map tiles (/tiles/<z>/<x>/<y>.png): pre-rendered MBTiles (default beside the
# map database), the on-device cache, and the upstream server for misses
# (empty = offline). OSM's tile policy: <= 2 connections, cache >= 7 days.
# DJANGO_TILES_MBTILES_PATH=/usr/share/e39rpi-maps/data/e39maps-tiles.mbtiles
# DJANGO_TILE_CACHE_DIR=/var/lib/e39maps/tiles
# DJANGO_TILE_UPSTREAM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# DJANGO_TILE_UPSTREAM_CONNECTIONS=2
# DJANGO_TILE_CACHE_MAX_AGE=604800
# Size limit for `manage.py prune_tile_cache` (oldest-fetched tiles first).
# DJANGO_TILE_CACHE_MAX_MB=1024

# Log level for the app and Django (stderr -> journal on the device).
# DJANGO_LOG_LEVEL=INFO
